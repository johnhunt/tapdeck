# Copy to player.env and edit, then: sudo systemctl restart tapdeck
# Friendly name of the Chromecast / Google speaker, exactly as shown in the Google Home app
CAST_NAME=Kitchen speaker
# Optional: the speaker's IP address. Helps when mDNS discovery can't see it.
CAST_HOST=
MUSIC_DIR=/home/pi/music
HTTP_PORT=8765
# Seconds without seeing the tag before playback pauses (any detection resets the clock)
REMOVE_GRACE=10
# Set e.g. 0.3 to force a volume on each connect; blank leaves the speaker's volume alone
CAST_VOLUME=
# Reader tuning (these gave 98% detection through 5mm plywood with an NTAG sticker)
NFC_RETRIES=16
NFC_RF_OFF=0.05
NFC_RF_SETTLE=0.03
